# Public env vars (bundled into the frontend)
NEXT_PUBLIC_API_URL=https://app.qlim8.com

# Shared secret for the CMS on-publish revalidation webhook (/api/revalidate)
# and the CMS pull/import endpoints (/api/cms/defaults, /api/cms/bundled-articles)
# the qlim8-app admin reads from at authoring time.
# Must match CMS_REVALIDATE_SECRET in the qlim8-app environment.
#
# Production (Docker): docker-compose.yml passes this through as
# ${CMS_REVALIDATE_SECRET}, which Docker Compose resolves from a .env file
# placed next to docker-compose.yml on the server (/opt/qlim8/.env): create
# it there with the real value; it is not part of this repo.
CMS_REVALIDATE_SECRET=replace-with-shared-revalidate-secret

# GitHub Actions secrets (sæt disse i Settings → Secrets → Actions)
# HETZNER_HOST=<server-ip>
# HETZNER_USER=root
# HETZNER_SSH_KEY=<privat-nøgle>
